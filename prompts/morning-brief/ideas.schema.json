{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Morning brief ideas (pass B)",
  "type": "object",
  "required": ["ideas"],
  "additionalProperties": false,
  "properties": {
    "ideas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": ["app", "title", "why"],
        "additionalProperties": false,
        "properties": {
          "app": { "type": "string", "minLength": 1, "maxLength": 60, "description": "A project id from the table, or \"cross\"." },
          "title": { "type": "string", "minLength": 1, "maxLength": 70, "description": "A noun phrase." },
          "why": { "type": "string", "minLength": 1, "maxLength": 400 },
          "flags": {
            "type": "array",
            "maxItems": 6,
            "items": { "type": "string", "pattern": "^(cost|outside_service|legal|repo_change|big|overlap:[A-Z0-9-]+)$" }
          }
        }
      }
    }
  }
}
