# The store is a devva engine (deploy/devva/README.md). Host default 127.0.0.1, port default 2505
DEVVA_HOST=
DEVVA_PORT=
# File holding the engine token (default ~/.config/plania/devva-token)
DEVVA_TOKEN_FILE=
# Optional: another build of the devva client (default vendor/devva-client/lib/index.js)
DEVVA_CLIENT=
# Lobe prefix; every store on one engine (service, dev server) needs its own. Default plania
PLANIA_DEVVA_PREFIX=
# Optional: the host folder the engine's meta/dumps is mounted on (the same value the compose file gets).
# Set, the nightly backup also keeps the engine's own export there. Unset, only plania's dump is taken.
PLANIA_DEVVA_DUMP_DIR=
# Shared with MCP clients as PLANIA_MCP_TOKEN
MCP_BEARER_TOKEN=
# At least 32 bytes, e.g. `openssl rand -base64 48`
SESSION_SECRET=
# Output of `pnpm hash-password`. Never a plain password.
PLANIA_PASSWORD_HASH=
# Optional: read-only token for planning sessions (read tools only)
MCP_READ_TOKEN=
# Optional: token for /hooks/* (CI results, deploys); not valid on /mcp
PLANIA_CI_TOKEN=
# Optional: time zone the screen shows times in (default America/Mexico_City)
PLANIA_TZ=
# Optional: name in the CEO greeting (default Jorge)
PLANIA_CEO_NAME=
# Optional: for the pollers (settings.github / settings.vercel name these variables)
GITHUB_TOKEN=
VERCEL_TOKEN=
# Optional (2.12): web push to the phone. `pnpm vapid` prints a pair; the subject is a mailto: or https: URL
PLANIA_VAPID_PUBLIC=
PLANIA_VAPID_PRIVATE=
PLANIA_VAPID_SUBJECT=
# Optional: PLANIA_SEARCH=devva turns on the search tool (meaning, not words). It needs an embedding
# service; SEXTANT_URL is the sextant service's address, e.g. http://127.0.0.1:8080
PLANIA_SEARCH=
SEXTANT_URL=
