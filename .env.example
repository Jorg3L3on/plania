# Neon Free, aws-us-east-1
DATABASE_URL=
# Shared with MCP clients as PLANIA_MCP_TOKEN
MCP_BEARER_TOKEN=
# At least 32 bytes, e.g. `openssl rand -base64 48`
SESSION_SECRET=
# Output of `pnpm hash-password`. Never a plain password. Empty: the one made on the first-start screen
PLANIA_PASSWORD_HASH=
# Optional: read-only token for planning sessions (read tools only)
MCP_READ_TOKEN=
# Optional: token for /hooks/* (CI results, deploys); not valid on /mcp
PLANIA_CI_TOKEN=
# Optional: time zone the screen shows times in (default America/Mexico_City)
PLANIA_TZ=
# Optional: name in the CEO greeting (default Jorge)
PLANIA_CEO_NAME=
# Optional: for the pollers (settings.github / settings.vercel name these variables)
GITHUB_TOKEN=
VERCEL_TOKEN=
# Optional (2.12): web push to the phone. `pnpm vapid` prints a pair; the subject is a mailto: or https: URL
PLANIA_VAPID_PUBLIC=
PLANIA_VAPID_PRIVATE=
PLANIA_VAPID_SUBJECT=

# Morning brief and runner (see README "Morning brief")
# PLANIA_JOBS=1 also starts the heartbeat job (empty: on for an install made by the first-start screen, else off)
PLANIA_JOBS=
# Write-scope agent token the runner hands to woken bots (issued on /tokens; empty: the one first start made)
PLANIA_RUNNER_TOKEN=
# Read-scope agent token for the Morning brief passes (issued on /tokens, name morning-brief; empty: first start's)
PLANIA_BRIEF_TOKEN=
PLANIA_EVENT_WAKES=
# Defaults to http://127.0.0.1:3737/mcp
PLANIA_MCP_URL=
# Defaults to ~/.local/bin/claude, else the claude found on PATH
CLAUDE_CODE_BIN=
# Off macOS's keychain, the owner's code lives in this file (mode 0600). Default ~/.config/plania/owner-secret
PLANIA_OWNER_SECRET_FILE=
# Runs get Claude's own variables (ANTHROPIC_*, CLAUDE_*) unchanged, so Claude signs in the way you set it up.
# 1 drops ANTHROPIC_* from every run, so Claude uses your plan's login even with a key in this environment
# (the behaviour before PLA-I2-13). Off by default. README "What a run receives".
PLANIA_STRIP_ANTHROPIC_ENV=
# Defaults to ~/Developer/Projects
PLANIA_PROJECTS_ROOT=
# Where run worktrees are made (src/runner/worktree.ts). Defaults to ~/Developer/.plania-worktrees
PLANIA_WORKTREES_ROOT=
# Home project for Asistente, cross-app ideas and prompts (default plania)
PLANIA_HOME_PROJECT=
PLANIA_PROMPTS_PROJECT=
# Defaults to ~/.config/plania/github-token
PLANIA_GITHUB_TOKEN_FILE=
# DATABASE_URL: local Postgres 14 (Homebrew), e.g. postgres://localhost:5432/plania
# The agents' kit (README "The agents' kit"). All optional.
# project = runs load no user-level Claude settings or skills; bare = no auto-discovery.
# The install command sets project in a new .env; empty or off = the CLI's defaults
PLANIA_RUN_ISOLATION=
# 1 (default) fresh session after a failure or a QA return, 0 always resume, ab alternates
PLANIA_RETRY_FRESH=
# 0 = seats without packs carry no default skills
PLANIA_DEFAULT_KITS=
