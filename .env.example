# Neon Free, aws-us-east-1
DATABASE_URL=
# Shared with MCP clients as PLANIA_MCP_TOKEN
MCP_BEARER_TOKEN=
# At least 32 bytes, e.g. `openssl rand -base64 48`
SESSION_SECRET=
# Output of `pnpm hash-password`. Never a plain password.
PLANIA_PASSWORD_HASH=
# Optional: read-only token for planning sessions (read tools only)
MCP_READ_TOKEN=
# Optional: token for /hooks/* (CI results, deploys); not valid on /mcp
PLANIA_CI_TOKEN=
# Optional: time zone the screen shows times in (default America/Mexico_City)
PLANIA_TZ=
# Optional: name in the CEO greeting (default Jorge)
PLANIA_CEO_NAME=
# Optional: for the pollers (settings.github / settings.vercel name these variables)
GITHUB_TOKEN=
VERCEL_TOKEN=
# Optional (2.12): web push to the phone. `pnpm vapid` prints a pair; the subject is a mailto: or https: URL
PLANIA_VAPID_PUBLIC=
PLANIA_VAPID_PRIVATE=
PLANIA_VAPID_SUBJECT=
